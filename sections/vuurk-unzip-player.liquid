{%- comment -%}
  VUURK Unzip V2 (U1): reproductor de fotogramas controlado por arrastre.
  Sin patrón de fotogramas usa la secuencia 3D del envase con el arte oficial
  (assets/vuurk-unzip-berry-{d,m}-01…24.webp, renderizada con tools/vuurk-3d).
  En escritorio, cada fotograma se recorta con la silueta del envase
  (assets/vuurk-unzip-berry-matte-01…24.webp) para quitar el fondo gris de estudio.
  Al terminar la apertura, una capa independiente hace salir gummies de la boca
  (assets/vuurk-gummy-01…06.webp, tools/vuurk-3d/scripts/render_gummies.py).
  No sustituye a la sección VUURK · Envase 3D ni al prototipo V1.
{%- endcomment -%}
{%- liquid
  assign count = section.settings.frame_count
  assign pattern_d = section.settings.frames_desktop_pattern
  assign pattern_m = section.settings.frames_mobile_pattern
  assign using_test = false
  if pattern_d == blank
    assign using_test = true
    assign test_prefix = 'vuurk-unzip-berry'
    assign count = 24
  endif
  if count > 99
    assign pad = '000'
    assign digits = -3
  else
    assign pad = '00'
    assign digits = -2
  endif
  assign last_n = count | prepend: pad | slice: digits, 3

  if using_test
    assign fallback_d = test_prefix | append: '-d-' | append: last_n | append: '.webp' | asset_url
    assign fallback_m = test_prefix | append: '-m-' | append: last_n | append: '.webp' | asset_url
  else
    assign fallback_d = pattern_d | replace: '{n}', last_n
    assign fallback_m = pattern_m | default: pattern_d | replace: '{n}', last_n
  endif

  assign product = section.settings.product
  assign cta_url = section.settings.cta_link | default: '#comprar'
  if product != blank
    assign cta_url = product.url
  endif
-%}
{% render 'vuurk-assets' %}
{{ 'vuurk-unzip-player.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vuurk-unzip-player.js' | asset_url }}" defer></script>

<section
  class="vk vk--dark vk-unzip2"
  aria-labelledby="VkUnzip2Title-{{ section.id }}"
  data-vk-unzip2
>
  <div class="vk__wrap vk__pad">
    <div class="vk__head vk__head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vk__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="VkUnzip2Title-{{ section.id }}" class="vk__h2">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="vk__lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="vk-unzip2__fallback" data-vk-unzip2-fallback>
      <picture>
        <source media="(max-width: 749px)" srcset="{{ fallback_m }}">
        <img
          src="{{ fallback_d }}"
          alt="{{ section.settings.open_alt | escape }}"
          width="1200"
          height="640"
          loading="lazy"
          decoding="async"
        >
      </picture>
    </div>

    <div class="vk-unzip2__player" data-vk-unzip2-player hidden>
      {%- comment -%} Salpicadura del arte oficial detrás del envase (solo escritorio, CSS). {%- endcomment -%}
      <div
        class="vk-unzip2__splash"
        style="--vk-splash: url({{ 'vuurk-splash.webp' | asset_url }})"
        aria-hidden="true"
      ></div>
      <div class="vk-unzip2__stage" data-vk-unzip2-stage>
        <canvas class="vk-unzip2__canvas" data-vk-unzip2-canvas aria-hidden="true"></canvas>
        <div class="vk-unzip2__burst" data-vk-unzip2-burst aria-hidden="true"></div>
        <span class="vk-unzip2__loader" aria-hidden="true">Cargando…</span>
        <div class="vk-unzip2__track">
          <div
            class="vk-unzip2__handle"
            data-vk-unzip2-handle
            role="slider"
            tabindex="0"
            aria-label="{{ section.settings.slider_label | escape }}"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-valuetext="Apertura 0 %"
          ></div>
        </div>
      </div>
      <p class="vk-unzip2__sr" role="status" aria-live="polite" data-vk-unzip2-status></p>
    </div>

    <div class="vk-unzip2__cta" data-vk-unzip2-cta>
      <a class="vk-btn" href="{{ cta_url }}">
        {{ section.settings.cta_label | escape }}
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <script type="application/json" data-vk-unzip2-frames>
      {
        "desktop": [
          {%- for i in (1..count) -%}
            {%- assign n = i | prepend: pad | slice: digits, 3 -%}
            {%- if using_test -%}
              {%- assign url = test_prefix | append: '-d-' | append: n | append: '.webp' | asset_url -%}
            {%- else -%}
              {%- assign url = pattern_d | replace: '{n}', n -%}
            {%- endif -%}
            {{ url | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "mobile": [
          {%- for i in (1..count) -%}
            {%- assign n = i | prepend: pad | slice: digits, 3 -%}
            {%- if using_test -%}
              {%- assign url = test_prefix | append: '-m-' | append: n | append: '.webp' | asset_url -%}
            {%- else -%}
              {%- assign url = pattern_m | default: pattern_d | replace: '{n}', n -%}
            {%- endif -%}
            {{ url | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "mattes": [
          {%- if using_test -%}
            {%- for i in (1..count) -%}
              {%- assign n = i | prepend: pad | slice: digits, 3 -%}
              {{ test_prefix | append: '-matte-' | append: n | append: '.webp' | asset_url | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          {%- endif -%}
        ],
        "gummies": [
          {%- for i in (1..6) -%}
            {{ 'vuurk-gummy-0' | append: i | append: '.webp' | asset_url | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </div>
</section>

{% schema %}
{
  "name": "VUURK · Unzip (prueba)",
  "tag": "div",
  "class": "vk-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Experiencia VUURK" },
    { "type": "text", "id": "title", "label": "Título", "default": "Abrí tu energía." },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "slider_label", "label": "Nombre accesible del control", "default": "Apertura del envase" },
    { "type": "text", "id": "open_alt", "label": "Texto alternativo del envase abierto", "default": "Envase VUURK abierto" },
    { "type": "header", "content": "Compra" },
    { "type": "product", "id": "product", "label": "Producto VUURK" },
    { "type": "url", "id": "cta_link", "label": "Enlace si no hay producto" },
    { "type": "text", "id": "cta_label", "label": "Botón de compra", "default": "Comprar VUURK" },
    { "type": "header", "content": "Fotogramas" },
    {
      "type": "paragraph",
      "content": "Vacío = fotogramas de PRUEBA del theme. Para la secuencia final, subir los fotogramas a Contenido > Archivos y pegar la URL con {n} en lugar del número (01, 02… o 001 si hay más de 99)."
    },
    { "type": "text", "id": "frames_desktop_pattern", "label": "URL de fotogramas escritorio" },
    { "type": "text", "id": "frames_mobile_pattern", "label": "URL de fotogramas móvil" },
    {
      "type": "range",
      "id": "frame_count",
      "label": "Cantidad de fotogramas",
      "min": 12,
      "max": 120,
      "step": 6,
      "default": 72
    }
  ],
  "presets": [{ "name": "VUURK · Unzip (prueba)" }]
}
{% endschema %}
